{
  "name": "@chriskirsch/ibmi-docs-mcp",
  "version": "0.4.0",
  "description": "MCP comunitario para consultar documentación oficial IBM i/AS400 desde un corpus local sin depender de RDi.",
  "main": "./dist/src/server.js",
  "scripts": {
    "test": "vitest run tests",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "export:rdi": "tsx src/cli.ts export-rdi",
    "sync:ibm": "tsx src/cli.ts sync-ibm --out data/ibm-docs-cache",
    "build:pack": "tsx src/cli.ts build-pack --input data --out data/pack",
    "smoke": "tsx scripts/smoke.ts",
    "dev:export-rdi": "tsx src/cli.ts export-rdi",
    "pack:archive": "tsx scripts/create-pack-archive.ts",
    "pack:validate": "tsx src/cli.ts validate-pack",
    "bench:golden": "tsx scripts/golden-benchmark.ts",
    "setup:check": "tsx src/cli.ts setup --pack data/pack"
  },
  "keywords": [
    "mcp",
    "ibm-i",
    "as400",
    "rpgle",
    "clle",
    "dds",
    "db2-for-i",
    "sqlite-fts5"
  ],
  "author": "h0w4r",
  "license": "ISC",
  "type": "module",
  "bin": {
    "ibmi-docs-mcp": "./dist/src/server.js",
    "ibmi-docs": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs",
    "pack-template.json",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.1.2",
    "commander": "^14.0.2",
    "fast-xml-parser": "^5.3.2",
    "p-limit": "^7.2.0",
    "sanitize-filename": "^1.6.3",
    "tar": "^7.5.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/sanitize-filename": "^1.6.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h0w4r/MCP-IBMiDocs.git"
  },
  "bugs": {
    "url": "https://github.com/h0w4r/MCP-IBMiDocs/issues"
  },
  "homepage": "https://github.com/h0w4r/MCP-IBMiDocs#readme"
}
